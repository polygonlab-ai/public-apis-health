{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/polygonlab-ai/public-apis-health/main/schema/hosts.schema.json",
    "title": "Hosts of the links of the public-apis list",
    "description": "The list read by host, as published in data/hosts.json.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "source",
        "source_page",
        "source_date",
        "count",
        "hosts"
    ],
    "properties": {
        "source": {
            "description": "Origin of the list.",
            "type": "string",
            "minLength": 1
        },
        "source_page": {
            "description": "Page of the original repository.",
            "type": "string",
            "pattern": "^https://"
        },
        "source_date": {
            "description": "Date of the run (YYYY-MM-DD, Paris time). Null as long as no run has been made.",
            "type": [
                "string",
                "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "count": {
            "description": "Number of hosts.",
            "type": "integer",
            "minimum": 0
        },
        "hosts": {
            "description": "Hosts, from the most to the least loaded, then by name.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/host"
            }
        }
    },
    "definitions": {
        "host": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "host",
                "api_count",
                "categories",
                "result",
                "responding_count"
            ],
            "properties": {
                "host": {
                    "description": "Name of the host, in lower case.",
                    "type": "string",
                    "minLength": 1
                },
                "api_count": {
                    "description": "Number of entries whose link is on this host.",
                    "type": "integer",
                    "minimum": 1
                },
                "categories": {
                    "description": "Categories of these entries, sorted.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "result": {
                    "description": "The most favourable of the test results of the entries of the host.",
                    "enum": [
                        "responds",
                        "access_denied",
                        "not_found",
                        "client_error",
                        "server_error",
                        "unreachable",
                        "not_tested"
                    ]
                },
                "responding_count": {
                    "description": "Number of entries of the host whose result is responds.",
                    "type": "integer",
                    "minimum": 0
                }
            }
        }
    }
}
